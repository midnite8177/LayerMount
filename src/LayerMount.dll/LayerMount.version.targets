<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Imported by LayerMount.dll.vcxproj and LayerMount-static.vcxproj.

    Before ClCompile, this target asks MSBuild to build the header
    generator in LayerMount.version.proj. The generator writes
    public\LayerMountVersion.h from LayerMountVersion.h.in and
    version.props.

    The MSBuild task is the point of this indirection. Both vcxproj
    files build in parallel under /m, and a target that runs in each of
    them writes the header twice at the same time. MSBuild builds one
    project instance only once per build, so the generator runs once and
    the second caller waits. RemoveProperties drops Configuration and
    Platform, so every caller maps to the same project instance.
  -->

  <Target Name="GenerateLayerMountVersionHeader"
          BeforeTargets="ClCompile">
    <MSBuild Projects="$(MSBuildThisFileDirectory)LayerMount.version.proj"
             Targets="GenerateLayerMountVersionHeader"
             RemoveProperties="Configuration;Platform" />
  </Target>

</Project>
