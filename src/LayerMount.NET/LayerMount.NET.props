<Project>

  <!--
    LayerMount.NET.props : imported by LayerMount.NET.csproj.

    Registers the native LayerMount.dll (built by src/LayerMount.dll/
    LayerMount.dll.vcxproj into <engine root>\$(Platform)\$(Configuration)\,
    two levels above this file) as a ReferenceCopyLocalPaths item. MSBuild
    uses this list to copy runtime dependencies into $(OutDir) both for
    this project AND for downstream projects that take a ProjectReference
    on LayerMount.NET, so the native DLL follows the managed assembly
    through the dependency graph.

    The managed wrapper itself is AnyCPU; the per-RID native asset is
    chosen by override property $(LayerMountNativeArch) which defaults to
    x64 (the local-dev common case). The test projects build for x64 or
    ARM64, but this file is evaluated in the AnyCPU wrapper project and
    cannot see the test project's platform, so an ARM64 test build passes
    /p:LayerMountNativeArch=ARM64 on the command line. Consumers building
    an arm64 host adapter via ProjectReference can set
    $(LayerMountNativeArch)=ARM64 the same way to pick up the arm64 DLL
    instead. For published consumers, the LayerMount.Native NuGet package
    handles RID resolution automatically and this props is not in play.

    Guarded with Exists() so a managed-only build (before the native DLL
    exists) does not fail; it simply emits a build warning.
  -->

  <PropertyGroup>
    <LayerMountNativeArch Condition="'$(LayerMountNativeArch)' == ''">x64</LayerMountNativeArch>
    <!--
      The path starts at the engine root, never at $(SolutionDir). A host
      solution that builds this project by reference writes its output to
      $(SolutionDir)$(LayerMountNativeArch)\$(Configuration)\, so a path
      that started there would read the host's own stale copy and copy it
      onto itself.
    -->
    <_NativeLayerMountDllPath>$(MSBuildThisFileDirectory)..\..\$(LayerMountNativeArch)\$(Configuration)\LayerMount.dll</_NativeLayerMountDllPath>
  </PropertyGroup>

  <Target Name="RegisterNativeLayerMountDll"
          BeforeTargets="ResolveAssemblyReferences;GetCopyToOutputDirectoryItems"
          Condition="Exists('$(_NativeLayerMountDllPath)')">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="$(_NativeLayerMountDllPath)">
        <TargetPath>LayerMount.dll</TargetPath>
      </ReferenceCopyLocalPaths>
      <None Include="$(_NativeLayerMountDllPath)">
        <Link>LayerMount.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Pack>false</Pack>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="WarnMissingNativeLayerMountDll"
          AfterTargets="Build"
          Condition="!Exists('$(_NativeLayerMountDllPath)')">
    <Warning Text="LayerMount.dll not found at '$(_NativeLayerMountDllPath)'. Build src/LayerMount.dll/LayerMount.dll.vcxproj first, then rebuild this project to get the native DLL side-by-side."
             Code="OVL-NET-001" />
  </Target>

</Project>
