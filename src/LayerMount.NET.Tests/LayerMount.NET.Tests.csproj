<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- x64 and ARM64 only: the test host must match the native
         LayerMount.dll it loads, so there is no AnyCPU. A build with
         no platform given (plain `dotnet test`) uses x64. -->
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>

    <RootNamespace>LayerMount.Tests</RootNamespace>
    <AssemblyName>LayerMount.NET.Tests</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <!-- LayerMount.NET.props flows LayerMount.dll into our bin\ via
         ReferenceCopyLocalPaths, so taking a ProjectReference on the
         managed wrapper is all we need for the native library. -->
    <ProjectReference Include="..\LayerMount.NET\LayerMount.NET.csproj" />

    <ProjectReference Include="..\LayerMount.TestShared\LayerMount.TestShared.csproj" />
  </ItemGroup>

</Project>
